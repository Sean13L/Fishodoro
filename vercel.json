{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --omit=dev --ignore-scripts",
  "regions": ["iad1"],
  "functions": { "api/index.js": { "includeFiles": "public/**" } },
  "routes": [{ "src": "/(.*)", "dest": "/api/index.js" }],
  "crons": [{ "path": "/api/cron/purge", "schedule": "0 8 * * *" }]
}
