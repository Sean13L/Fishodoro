# Copy to .env.production. Never commit it.
# Production refuses to start unless everything in "Required" is set.

NODE_ENV=production

# --- Required ---
APP_URL=https://your-domain.example
# Generate with: openssl rand -base64 48
APP_SECRET=

# Shown in the footer, legal pages and emails.
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
GOVERNING_LAW=the laws of the Province of Ontario and the federal laws of Canada that apply there
# The country your database is stored in, as it should read in the Privacy Policy.
DATA_LOCATION=

# Any HTTP API that takes JSON { from, to, subject, text } with a bearer key, such as Resend.
MAIL_API_URL=https://api.resend.com/emails
MAIL_API_KEY=
MAIL_FROM=Fishodoro <security@your-domain.example>

# --- Optional: running the server ---
PORT=3000
# Use 0.0.0.0 only when a host or container needs it.
HOST=127.0.0.1
# Keep the database on a persistent disk, outside any web root.
DB_PATH=./data/fishodoro.db
# Set to 1 only behind exactly one trusted reverse proxy, which must set X-Forwarded-For.
TRUST_PROXY=0
