# Production settings. On Vercel, add each one with: npx vercel env add NAME production
# The server refuses to start in production if any of them is missing. Never commit real values.

APP_URL=https://fishodoro.vercel.app
# Generate each with: openssl rand -base64 48
APP_SECRET=
CRON_SECRET=

# Shown in the footer, legal pages and emails.
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
GOVERNING_LAW=the laws of the Province of Ontario and the federal laws of Canada that apply there
DATA_LOCATION=Canada

# From turso.tech: the database URL (libsql://...) and an auth token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# From brevo.com: an API key (not an SMTP key), and a sender address verified there.
MAIL_API_KEY=
MAIL_FROM=
